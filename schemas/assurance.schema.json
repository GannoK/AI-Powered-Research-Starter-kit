{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guildtechnologysolutions.com/schemas/research-assurance.schema.json",
  "title": "Research Starter Kit Assurance Manifest",
  "type": "object",
  "required": [
    "format_version",
    "project",
    "project_type",
    "assurance_profile",
    "result_states",
    "required_checks",
    "manual_controls",
    "release_requirements"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format_version": {
      "type": "string"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "project_type": {
      "type": "string",
      "minLength": 1
    },
    "assurance_profile": {
      "type": "string",
      "minLength": 1
    },
    "result_states": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "manual_controls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "release_requirements": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
